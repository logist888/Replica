# Пароль базы данных: длинная случайная строка (например, openssl rand -hex 24)
DB_PASSWORD=
# Токен для выгрузки данных /api/admin/export: не короче 16 символов (openssl rand -hex 24)
ADMIN_TOKEN=
# Адрес сайта. Пусто или :80 = только HTTP по IP. Домен (например test.example.ru) = HTTPS автоматически.
SITE_ADDRESS=:80
